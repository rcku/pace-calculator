{
    "name": "stride-pace-calculator",
    "version": "1.0.0",
    "private": true,
    "description": "Running pace, race equivalents, and VDOT training pace calculator",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/rcku/stride.git"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "build": "vite build && cpy LICENSE dist",
        "test": "node --import tsx --test tests/calculations.test.ts tests/app.test.ts tests/workouts.test.ts",
        "test:build": "node --import tsx --test tests/build.test.ts",
        "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run test:build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc"
    },
    "devDependencies": {
        "@preact/preset-vite": "2.10.6",
        "@types/node": "24.19.2",
        "cpy-cli": "7.0.0",
        "happy-dom": "21.0.1",
        "prettier": "3.6.2",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.4"
    },
    "dependencies": {
        "preact": "11.0.1"
    }
}
